# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# OKX API Configuration
# 获取方式: https://www.okx.com/account/my-api
# 模拟盘和实盘需分别创建，在系统设置页面中配置
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_FLAG=1

# Database (MySQL)
MYSQL_DATABASE=factor
MYSQL_USER=factor
MYSQL_PASSWORD=factor
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Redis (Celery Broker & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Risk Management
MAX_POSITION_PCT=0.2
MAX_ORDER_VALUE=10000
MAX_DAILY_LOSS=500
STOP_LOSS_PCT=0.05
